#
#
#
#
# Loopback
auto lo
iface lo inet loopback

# First Network Interface
# NAT/For Internet
auto enp0s3
iface enp0s3 inet dhcp

# Second Network Interface
# Bridge/For Internal Connection & Internet
auto enp0s8
iface enp0s8 inet dhcp
