# Server Name
# Set based on your servers host name
SERVER_NAME={{ inventory_hostname }}

# Domain Info
DOMAIN_ADDRESS={{ domain_name }}
NODE_SUB_DOMAIN=node-{{ inventory_hostname }}
CONTAINER_SUB_DOMAIN=pod-{{ inventory_hostname }}

# Set Restart Policy
RESTART_POLICY=unless-stopped

# Image Versions
NDEEXP_VERSION=v1.11.1
CADV_VERSION=v0.55.1
PROMTAIL_VERSION=3.6.11

# Loki Variables
# http://logs-1.nima.local:3100/loki/api/v1/push
LOKI_SCHEME={{ LOKI_SCHEME }}
LOKI_URL={{ LOKI_URL }}
LOKI_USER={{ LOKI_USER }}
LOKI_PASS={{ LOKI_PASS }}
